modbus_dev m
byte redata[8]
double y_step_mm = 1
double px_in_mm = 16.4
double dead_zone_mm = 0.125
double corection_factor = 0.25
double camera_reference
double camera_center
double delta_x

pose p_start
pose p_current
pose p_correction

func double camera_read()
read(m, redata, 0, 8)   
for(int i=0;i<8;i++)
$I[i]=redata[i]
endfor
double camera_x1
double camera_y1
double camera_x2
double camera_y2
camera_x1 = $I[1]*256 + $I[0]
camera_y1 = $I[3]*256 + $I[2] 
camera_x2 = $I[5]*256 + $I[4]
camera_y2 = $I[7]*256 + $I[6] 
camera_center = (camera_x1 +  camera_x2)/2
delta_x = (camera_center - camera_reference)/px_in_mm *corection_factor //deltaX
print "Camera center = ", camera_center
return delta_x
//print "X1: ", camera_x1
//print "Y1: ", camera_y1
//print "X2: ", camera_x2
//print "Y2: ", camera_y2
endfunc

func void correction()
p_current = cpose($tool1, $DFWOBJ)
double delta_y = abs(p_current.y - p_finish.y)
if (delta_x > 0) //при відхил. X в +
p_correction.x = p_current.x - (delta_y * delta_x / y_step_mm)
else //при відхил. X в -
p_correction.x = p_current.x + (delta_y * delta_x / y_step_mm)
endif
print "Corection pose X = ", p_correction.x
endfunc

func void main()
open(m, "rtserMB0", 1, 9600,8,one,none)
clearbuff (m)
waittime 2
camera_read()
waittime 1
camera_read()
camera_reference = camera_center
p_start = cpose($tool1, $DFWOBJ)
p_current = p_start
p_correction = p_finish
p_correction.x = p_start.x
interrupt 0, when: abs(camera_read()) > dead_zone_mm, do: correction()
while (p_current.y >  p_finish.y)
lin p_correction,v1,$tool1
endwhile
endfunc